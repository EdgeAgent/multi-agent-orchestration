{
  "name": "Hierarchical Supervisor Multi-Agent Orchestration",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "orchestrate",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "prompt": "={{ $json.body.task }}",
        "model": "gpt-4o",
        "options": {
          "systemMessage": "You are the Hierarchical Supervisor agent. Decompose the task and assign subtasks to worker agents."
        }
      },
      "name": "Supervisor Orchestrator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "assignments": {
          "parameters": [
            {
              "name": "status",
              "value": "completed"
            },
            {
              "name": "result",
              "value": "={{ $json.output }}"
            }
          ]
        }
      },
      "name": "Format Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Supervisor Orchestrator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supervisor Orchestrator": {
      "main": [
        [
          {
            "node": "Format Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
